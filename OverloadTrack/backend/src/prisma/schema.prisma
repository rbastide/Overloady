datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String           @id @default(cuid())
  username    String           @unique @map("email")
  password    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  profile     Profile?
  sessions    WorkoutSession[]
  routines    Routine[]
  pushSubscriptions PushSubscription[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth DateTime
  height      Int
  weight      Float
  goal        String   @default("BODYBUILDING")
  experience  String   @default("BEGINNER") // NONE | BEGINNER | INTERMEDIATE | ADVANCED
  bodyFat     Float?   // optional, in %
  testWeekCompleted Boolean @default(false)
  testWeekProgress  Int     @default(0)
  testWeekSkipped   Boolean @default(false) // the athlete declined the calibration: no test UI at all
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkoutSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId String?
  routine   Routine?      @relation(fields: [routineId], references: [id], onDelete: SetNull)
  rpe       Int           @default(7)
  title     String?       // display name (programme, recommended or calibration session)
  testWeekStep Int?       // 1-3 when the session belongs to the calibration week
  notes     String?       // the athlete's own notes only
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  exercises ExerciseLog[]
}

model Routine {
  id        String           @id @default(cuid())
  name      String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  WorkoutSession[]
  exercises Exercise[]
  // Exercise ids in the order the athlete arranged them (the relation itself is unordered)
  exerciseOrder String[]
}

model Exercise {
  id        String        @id @default(cuid())
  wgerId    Int?          @unique
  name      String
  category  String        @default("Général")
  source    String        @default("custom") // local | wger | custom
  routines  Routine[]
  logs      ExerciseLog[]
}

model ExerciseLog {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  sets       SetLog[]
}

model SetLog {
  id            String      @id @default(cuid())
  exerciseLogId String
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  reps          Int
  weight        Float
  completed     Boolean     @default(true)
}

// A device that receives the rest timer notifications (Web Push, home-screen app on iOS 16.4+)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// The server's Web Push (VAPID) key pair, generated on first start when not set in the environment:
// a subscription is bound to it, so it has to survive restarts and deploys.
model PushConfig {
  id         Int    @id @default(1)
  publicKey  String
  privateKey String
}
